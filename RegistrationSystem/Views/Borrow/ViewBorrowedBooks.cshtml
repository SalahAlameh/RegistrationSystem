@model List<RegistrationSystem.Models.Borrow>

@{
    ViewData["Title"] = "Borrowed Books";
}

<h2>Borrowed Books</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success" role="alert">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger" role="alert">
        @TempData["ErrorMessage"]
    </div>
}

<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th>Person</th>
            <th>Book</th>
            <th>Borrow Date</th>
            <th>Due Date</th>
            <th>Return Date</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var borrow in Model)
        {
            <tr>
                <td>@borrow.Person?.FullName</td>
                <td>@borrow.Book?.Title</td>
                <td>
                    @($"{borrow.BorrowDate:yyyy-MM-dd HH:mm} UTC")
                </td>
                <td>
                    @($"{borrow.DueDate:yyyy-MM-dd HH:mm} UTC")
                </td>
                <td>
                    @(borrow.ReturnDate.HasValue
                    ? $"{borrow.ReturnDate.Value:yyyy-MM-dd HH:mm} UTC"
                    : "Not returned")
                </td>

                <td>
                    @if (borrow.ReturnDate == null)
                    {
                        @if (borrow.DueDate < DateTime.UtcNow)
                        {
                            <span class="badge bg-warning text-dark">Overdue</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Active</span>
                        }
                    }
                    else
                    {
                        <span class="badge bg-success">Returned</span>
                    }
                </td>
                <td>
                    @if (borrow.ReturnDate == null)
                    {
                        <form asp-action="ReturnBook" asp-route-id="@borrow.Id" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-primary">Return</button>
                        </form>
                    }
                    else
                    {
                        <span class="text-muted">
                            @($"{borrow.ReturnDate.Value:yyyy-MM-dd HH:mm} UTC")
                        </span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
