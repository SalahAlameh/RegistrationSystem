@model List<RegistrationSystem.Models.Borrow>

@* Retrieves Borrowing-page translations from the shared
   English or Arabic resource file. *@
@inject Microsoft.Extensions.Localization.IStringLocalizer<RegistrationSystem.SharedResource> Localizer

@{
    ViewData["Title"] = Localizer["BorrowedBooksTitle"];
}

<h2>@Localizer["BorrowedBooksTitle"]</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success" role="alert">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger" role="alert">
        @TempData["ErrorMessage"]
    </div>
}

<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th>@Localizer["BorrowPersonLabel"]</th>
            <th>@Localizer["BorrowBookLabel"]</th>
            <th>@Localizer["BorrowDateLabel"]</th>
            <th>@Localizer["DueDateLabel"]</th>
            <th>@Localizer["ReturnDateLabel"]</th>
            <th>@Localizer["BorrowStatusLabel"]</th>
            <th>@Localizer["ActionsLabel"]</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var borrow in Model)
        {
            <tr>
                <td>@borrow.Person?.FullName</td>
                <td>@borrow.Book?.Title</td>
                <td>
                    @($"{borrow.BorrowDate:yyyy-MM-dd HH:mm} UTC")
                </td>
                <td>
                    @($"{borrow.DueDate:yyyy-MM-dd HH:mm} UTC")
                </td>
                <td>
                    @(borrow.ReturnDate.HasValue
                    ? $"{borrow.ReturnDate.Value:yyyy-MM-dd HH:mm} UTC"
                    : Localizer["NotReturnedLabel"])
                </td>

                <td>
                    @if (borrow.ReturnDate == null)
                    {
                        @if (borrow.DueDate < DateTime.UtcNow)
                        {
                            <span class="badge bg-warning text-dark">@Localizer["OverdueStatus"]</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">@Localizer["ActiveStatus"]</span>
                        }
                    }
                    else
                    {
                        <span class="badge bg-success">@Localizer["ReturnedStatus"]</span>
                    }
                </td>
                <td>
                    @if (borrow.ReturnDate == null)
                    {
                        <form asp-action="ReturnBook" asp-route-id="@borrow.Id" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-primary">@Localizer["ReturnButton"]</button>
                        </form>
                    }
                    else
                    {
                        <span class="text-muted">
                            @($"{borrow.ReturnDate.Value:yyyy-MM-dd HH:mm} UTC")
                        </span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
