@model RegistrationSystem.Models.BorrowViewModel

@using System.Text.Json

@* Retrieves Borrowing-page translations from the shared
   English or Arabic resource file. *@
@inject Microsoft.Extensions.Localization.IStringLocalizer<RegistrationSystem.SharedResource> Localizer

@{
    ViewData["Title"] = Localizer["BorrowBookPageTitle"];
}

<h2>@Localizer["BorrowBookPageTitle"]</h2>

<div asp-validation-summary="All" class="text-danger"></div>

<form asp-action="BorrowBook" method="post">
    @if (Model.CanChoosePerson)
    {
        @* Admins may select any active Person. *@
        <div class="mb-3">
            <label asp-for="PersonId"
                   class="form-label">
                @Localizer["BorrowPersonLabel"]
            </label>

            <select asp-for="PersonId"
                    asp-items="Model.Persons"
                    class="form-select">
                <option value="">
                    @Localizer["SelectPersonOption"]
                </option>
            </select>

            <span asp-validation-for="PersonId"
                  class="text-danger">
            </span>
        </div>
    }
    else if (Model.CanBorrow)
    {
        @* A regular User's Person is selected automatically. *@
        <div class="mb-3">
            <label class="form-label">
                @Localizer["BorrowPersonLabel"]
            </label>

            <input asp-for="PersonId"
                   type="hidden" />

            <input type="text"
                   class="form-control"
                   value="@Model.BorrowingPersonName"
                   readonly />

            <div class="form-text">
                @Localizer["AccountLinkedToPersonMessage"]
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-danger"
             role="alert">
            @Localizer["BorrowAccountNotLinked"]
        </div>
    }

    @if (Model.CanBorrow)
    {
        <div class="mb-3">
            <label asp-for="CategoryId"
                   class="form-label">
                @Localizer["FilterByCategoryLabel"]
            </label>

            <select asp-for="CategoryId"
                    asp-items="Model.Categories"
                    class="form-select">
                <option value="">
                    @Localizer["AllCategoriesOption"]
                </option>
            </select>
        </div>

        <div class="mb-3">
            <label asp-for="BookId"
                   class="form-label">
                @Localizer["BorrowBookLabel"]
            </label>

            <select asp-for="BookId"
                    asp-items="Model.Books"
                    class="form-select">
                <option value="">
                    @Localizer["SelectBookOption"]
                </option>
            </select>

            <span asp-validation-for="BookId"
                  class="text-danger">
            </span>
        </div>

        <button type="submit"
                class="btn btn-primary">
            @Localizer["BorrowButton"]
        </button>
    }
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        // JSON serialization safely places the translated prompt in JavaScript.
        var selectBookText =
            @Html.Raw(JsonSerializer.Serialize(
                Localizer["SelectBookOption"].Value));

        $(document).ready(function () {
            $('#CategoryId').on('change', function() { // this whole block only runs the moment the user picks a different category, not on page load
                var selectedCategoryId = $(this).val(); // grabs whatever the user just picked (or "" if they picked "-- All Categories --")

                $.getJSON('/Borrow/GetBooksByCategory', { categoryId: selectedCategoryId }, function(books) { // it sends a background request to the endpoint from Step 3, without reloading the page, and once the server responds with the JSON array, the function in the last argument runs with that data
                    var bookDropdown = $('#BookId');
                    bookDropdown.empty(); // wipes out whatever options the Book dropdown currently has, since we're about to replace them
                    bookDropdown.append($('<option></option>').val('').text(selectBookText)); // re-adds the localized placeholder option first, same as it had originally

                    $.each(books, function (index, book) {
                        bookDropdown.append($('<option></option>').val(book.value).text(book.text)); // jQuery's loop helper; walks through every {value, text} object the server sent back and builds a real <option> for each one
                    });
                });
            });
        });
    </script>
}
