@model RegistrationSystem.Models.RegisterViewModel

@* Retrieves Register translations from the shared
   English or Arabic resource file. *@
@inject Microsoft.Extensions.Localization.IStringLocalizer<
RegistrationSystem.SharedResource > Localizer

@{
    ViewData["Title"] =
        Localizer["RegisterTitle"];
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <section>
            <h1 class="mb-3">
                @Localizer["RegisterTitle"]
            </h1>

            <h2 class="h4 mb-3">
                @Localizer["RegisterSubtitle"]
            </h2>

            <hr />

            <form asp-controller="Account"
                  asp-action="Register"
                  method="post">

                @* Preserves the page the visitor originally
                   requested before opening registration. *@
                <input asp-for="ReturnUrl"
                       type="hidden" />

                @* Displays account-creation errors that are
                   not connected to one specific field. *@
                <div asp-validation-summary="ModelOnly"
                     class="text-danger"
                     role="alert">
                </div>

                <div class="form-floating mb-3">
                    <input asp-for="Email"
                           class="form-control"
                           autocomplete="username"
                           aria-required="true"
                           placeholder="@Localizer["EmailPlaceholder"]" />

                    <label asp-for="Email"
                           class="form-label">
                        @Localizer["EmailLabel"]
                    </label>

                    <span asp-validation-for="Email"
                          class="text-danger">
                    </span>
                </div>

                <div class="form-floating mb-3">
                    <input asp-for="Password"
                           class="form-control"
                           autocomplete="new-password"
                           aria-required="true"
                           placeholder="@Localizer["PasswordPlaceholder"]" />

                    <label asp-for="Password"
                           class="form-label">
                        @Localizer["PasswordLabel"]
                    </label>

                    <span asp-validation-for="Password"
                          class="text-danger">
                    </span>
                </div>

                <div class="form-floating mb-3">
                    <input asp-for="ConfirmPassword"
                           class="form-control"
                           autocomplete="new-password"
                           aria-required="true"
                           placeholder="@Localizer["ConfirmPasswordPlaceholder"]" />

                    <label asp-for="ConfirmPassword"
                           class="form-label">
                        @Localizer["ConfirmPasswordLabel"]
                    </label>

                    <span asp-validation-for="ConfirmPassword"
                          class="text-danger">
                    </span>
                </div>

                <button type="submit"
                        class="w-100 btn btn-lg btn-primary">
                    @Localizer["RegisterButton"]
                </button>

                <p class="mt-3">
                    @Localizer["AlreadyHaveAccount"]
                    <a asp-controller="Account"
                       asp-action="Login"
                       asp-route-returnUrl="@Model.ReturnUrl">
                        @Localizer["LoginLink"]
                    </a>
                </p>
            </form>
        </section>
    </div>
</div>

@section Scripts {
    @* Enables client-side form validation without
       waiting for a full request to the server. *@
    <partial name="_ValidationScriptsPartial" />
}