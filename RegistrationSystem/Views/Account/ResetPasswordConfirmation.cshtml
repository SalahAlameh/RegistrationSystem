@inject Microsoft.Extensions.Localization.IStringLocalizer<RegistrationSystem.SharedResource> Localizer

@{
    ViewData["Title"] = Localizer["ResetPasswordConfirmationTitle"];
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="alert alert-success" role="status">
            <h1 class="h3">@Localizer["ResetPasswordConfirmationTitle"]</h1>
            <p class="mb-0">@Localizer["ResetPasswordConfirmationMessage"]</p>
        </div>

        <a asp-controller="Account"
           asp-action="Login"
           class="btn btn-primary">
            @Localizer["LoginLink"]
        </a>
    </div>
</div>
