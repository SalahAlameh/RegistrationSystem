@inject Microsoft.Extensions.Localization.IStringLocalizer<RegistrationSystem.SharedResource> Localizer

@{
    ViewData["Title"] = Localizer["AccessDeniedTitle"];
}

<div class="text-center py-5">
    <h1 class="text-danger">@Localizer["AccessDeniedTitle"]</h1>
    <p class="lead">@Localizer["AccessDeniedMessage"]</p>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <a asp-controller="Home"
           asp-action="Index"
           class="btn btn-primary">
            @Localizer["ReturnToApplicationButton"]
        </a>
    }
    else
    {
        <a asp-controller="Account"
           asp-action="Login"
           class="btn btn-primary">
            @Localizer["LoginLink"]
        </a>
    }
</div>
