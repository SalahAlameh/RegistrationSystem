@model RegistrationSystem.Models.LoginViewModel

@* Retrieves Login translations from the shared
   English or Arabic resource file. *@
@inject Microsoft.Extensions.Localization.IStringLocalizer<
RegistrationSystem.SharedResource > Localizer

@{
    ViewData["Title"] =
        Localizer["LoginTitle"];
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <section>
            <h1 class="mb-3">
                @Localizer["LoginTitle"]
            </h1>

            <h2 class="h4 mb-3">
                @Localizer["LoginSubtitle"]
            </h2>

            <hr />

            <form asp-controller="Account"
                  asp-action="Login"
                  method="post">

                @* Preserves the page the visitor originally
                   requested before Identity required a login. *@
                <input asp-for="ReturnUrl"
                       type="hidden" />

                @* Displays Login errors that are not connected
                   to one specific field, such as an incorrect
                   email or password. *@
                <div asp-validation-summary="ModelOnly"
                     class="text-danger"
                     role="alert">
                </div>

                <div class="form-floating mb-3">
                    <input asp-for="Email"
                           class="form-control"
                           autocomplete="username"
                           aria-required="true"
                           placeholder="@Localizer["EmailPlaceholder"]" />

                    <label asp-for="Email"
                           class="form-label">
                        @Localizer["EmailLabel"]
                    </label>

                    <span asp-validation-for="Email"
                          class="text-danger">
                    </span>
                </div>

                <div class="form-floating mb-3">
                    <input asp-for="Password"
                           class="form-control"
                           autocomplete="current-password"
                           aria-required="true"
                           placeholder="@Localizer["PasswordPlaceholder"]" />

                    <label asp-for="Password"
                           class="form-label">
                        @Localizer["PasswordLabel"]
                    </label>

                    <span asp-validation-for="Password"
                          class="text-danger">
                    </span>
                </div>

                <div class="form-check mb-3">
                    <input asp-for="RememberMe"
                           class="form-check-input" />

                    <label asp-for="RememberMe"
                           class="form-check-label">
                        @Localizer["RememberMeLabel"]
                    </label>
                </div>

                <button type="submit"
                        class="w-100 btn btn-lg btn-primary">
                    @Localizer["LoginButton"]
                </button>

                <div class="mt-3">
                    <p>
                        <a asp-controller="Account"
                           asp-action="ForgotPassword">
                            @Localizer["ForgotPasswordLink"]
                        </a>
                    </p>

                    <p>
                        <a asp-controller="Account"
                           asp-action="Register"
                           asp-route-returnUrl="@Model.ReturnUrl">
                            @Localizer["RegisterLink"]
                        </a>
                    </p>
                </div>
            </form>
        </section>
    </div>
</div>

@section Scripts {
    @* Enables client-side form validation without
       waiting for a full request to the server. *@
    <partial name="_ValidationScriptsPartial" />
}
