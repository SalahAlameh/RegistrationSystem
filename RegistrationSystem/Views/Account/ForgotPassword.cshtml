@model RegistrationSystem.Models.ForgotPasswordViewModel

@inject Microsoft.Extensions.Localization.IStringLocalizer<RegistrationSystem.SharedResource> Localizer

@{
    ViewData["Title"] = Localizer["ForgotPasswordTitle"];
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <h1>@Localizer["ForgotPasswordTitle"]</h1>
        <p class="text-muted">@Localizer["ForgotPasswordDescription"]</p>

        <form asp-controller="Account"
              asp-action="ForgotPassword"
              method="post">
            <div asp-validation-summary="ModelOnly"
                 class="text-danger"
                 role="alert">
            </div>

            <div class="form-floating mb-3">
                <input asp-for="Email"
                       class="form-control"
                       autocomplete="email"
                       aria-required="true"
                       placeholder="@Localizer["EmailPlaceholder"]" />

                <label asp-for="Email">
                    @Localizer["EmailLabel"]
                </label>

                <span asp-validation-for="Email"
                      class="text-danger">
                </span>
            </div>

            <button type="submit"
                    class="w-100 btn btn-lg btn-primary">
                @Localizer["SendResetLinkButton"]
            </button>

            <p class="mt-3">
                <a asp-controller="Account"
                   asp-action="Login">
                    @Localizer["BackToLoginLink"]
                </a>
            </p>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
