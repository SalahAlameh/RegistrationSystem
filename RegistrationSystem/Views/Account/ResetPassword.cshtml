@model RegistrationSystem.Models.ResetPasswordViewModel

@inject Microsoft.Extensions.Localization.IStringLocalizer<RegistrationSystem.SharedResource> Localizer

@{
    ViewData["Title"] = Localizer["ResetPasswordTitle"];
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <h1>@Localizer["ResetPasswordTitle"]</h1>
        <p class="text-muted">@Localizer["ResetPasswordDescription"]</p>

        <form asp-controller="Account"
              asp-action="ResetPassword"
              method="post">
            <input asp-for="Code" type="hidden" />

            <div asp-validation-summary="ModelOnly"
                 class="text-danger"
                 role="alert">
            </div>

            <div class="form-floating mb-3">
                <input asp-for="Email"
                       class="form-control"
                       autocomplete="email"
                       aria-required="true"
                       placeholder="@Localizer["EmailPlaceholder"]" />
                <label asp-for="Email">@Localizer["EmailLabel"]</label>
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="form-floating mb-3">
                <input asp-for="Password"
                       class="form-control"
                       autocomplete="new-password"
                       aria-required="true"
                       placeholder="@Localizer["NewPasswordPlaceholder"]" />
                <label asp-for="Password">@Localizer["NewPasswordLabel"]</label>
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="form-floating mb-3">
                <input asp-for="ConfirmPassword"
                       class="form-control"
                       autocomplete="new-password"
                       aria-required="true"
                       placeholder="@Localizer["ConfirmNewPasswordPlaceholder"]" />
                <label asp-for="ConfirmPassword">@Localizer["ConfirmNewPasswordLabel"]</label>
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>

            <button type="submit"
                    class="w-100 btn btn-lg btn-primary">
                @Localizer["ResetPasswordButton"]
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
