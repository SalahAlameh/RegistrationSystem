@inject Microsoft.Extensions.Localization.IStringLocalizer<RegistrationSystem.SharedResource> Localizer

@{
    ViewData["Title"] = Localizer["ChangePasswordConfirmationTitle"];
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="alert alert-success" role="status">
            <h1 class="h3">@Localizer["ChangePasswordConfirmationTitle"]</h1>
            <p class="mb-0">@Localizer["ChangePasswordConfirmationMessage"]</p>
        </div>

        <a asp-controller="Home"
           asp-action="Index"
           class="btn btn-primary">
            @Localizer["ContinueButton"]
        </a>
    </div>
</div>
