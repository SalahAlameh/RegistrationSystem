@model RegistrationSystem.Models.ChangePasswordViewModel

@inject Microsoft.Extensions.Localization.IStringLocalizer<RegistrationSystem.SharedResource> Localizer

@{
    ViewData["Title"] = Localizer["ChangePasswordTitle"];
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <h1>@Localizer["ChangePasswordTitle"]</h1>
        <p class="text-muted">@Localizer["ChangePasswordDescription"]</p>

        <form asp-controller="Account"
              asp-action="ChangePassword"
              method="post">
            <div asp-validation-summary="ModelOnly"
                 class="text-danger"
                 role="alert">
            </div>

            <div class="form-floating mb-3">
                <input asp-for="CurrentPassword"
                       class="form-control"
                       autocomplete="current-password"
                       aria-required="true"
                       placeholder="@Localizer["CurrentPasswordPlaceholder"]" />
                <label asp-for="CurrentPassword">@Localizer["CurrentPasswordLabel"]</label>
                <span asp-validation-for="CurrentPassword" class="text-danger"></span>
            </div>

            <div class="form-floating mb-3">
                <input asp-for="NewPassword"
                       class="form-control"
                       autocomplete="new-password"
                       aria-required="true"
                       placeholder="@Localizer["NewPasswordPlaceholder"]" />
                <label asp-for="NewPassword">@Localizer["NewPasswordLabel"]</label>
                <span asp-validation-for="NewPassword" class="text-danger"></span>
            </div>

            <div class="form-floating mb-3">
                <input asp-for="ConfirmNewPassword"
                       class="form-control"
                       autocomplete="new-password"
                       aria-required="true"
                       placeholder="@Localizer["ConfirmNewPasswordPlaceholder"]" />
                <label asp-for="ConfirmNewPassword">@Localizer["ConfirmNewPasswordLabel"]</label>
                <span asp-validation-for="ConfirmNewPassword" class="text-danger"></span>
            </div>

            <button type="submit"
                    class="w-100 btn btn-lg btn-primary">
                @Localizer["UpdatePasswordButton"]
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
