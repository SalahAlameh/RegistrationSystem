@*this view looks different because it combines three technologies:
    C# and Razor → prepare server-side data
HTML/Bootstrap → build the visible page
JavaScript/Chart.js → draw the charts in the browser
*@
@*importing the JSON serializer*@
@using System.Text.Json 
@using System.Globalization
@model RegistrationSystem.Models.DashboardViewModel

@* Retrieves Dashboard translations from the shared
   English or Arabic resource file. *@
@inject Microsoft.Extensions.Localization.IStringLocalizer<RegistrationSystem.SharedResource> Localizer


@* the Razor C# block*@
@*everything inside this block
runs on the server before the HTML is sent to the browser*@
@{
    ViewData["Title"] =
    Localizer["DashboardTitle"];

    // Converts the service's stable yyyy-MM value into
    // a month name formatted for the selected language.
    var monthlyLabels = Model.MonthlyStatistics
        .Select(item =>
            DateTime.ParseExact(
                item.Month,
                "yyyy-MM",
                CultureInfo.InvariantCulture)
            .ToString(
                "MMMM yyyy",
                CultureInfo.CurrentUICulture))
        .ToList();

    var monthlyValues = Model.MonthlyStatistics
        .Select(item => item.BorrowCount) // go through each monthly statistic and take only its BorrowCount
        .ToList();

    var categoryLabels = Model.TopCategories
        .Select(item => item.Name) // go through each top category and take only its Name
        .ToList();

    var categoryValues = Model.TopCategories
        .Select(item => item.Count) // go through each top category and take only its Count
        .ToList();

    var activeUserLabels = Model.ActiveUsers
        .Select(item => item.Name) // go through each active user and take only its Name
        .ToList();

    var activeUserValues = Model.ActiveUsers
        .Select(item => item.Count) // go through each active user and take only its Count
        .ToList();

    // These values are serialized below so translated
    // resource text can be used safely by JavaScript.
    var borrowingsChartLabel =
        Localizer["BorrowingsChartLabel"].Value;

    var activeBorrowingsChartLabel =
        Localizer["ActiveBorrowingsChartLabel"].Value;

    // Chart.js uses the culture for formatting numbers
    // and the direction for its canvas-based text.
    var chartCulture =
        CultureInfo.CurrentUICulture.Name;

    var chartIsRightToLeft =
        CultureInfo.CurrentUICulture
            .TextInfo
            .IsRightToLeft;
}

<h1 class="mb-4">
    @Localizer["DashboardTitle"]
</h1>

@* Summary cards *@
<div class="row g-3 mb-4">
    <div class="col-md-6 col-xl-3">
        <div class="card text-bg-primary h-100">
            <div class="card-body">
                <h5 class="card-title">
                    @Localizer["TotalBooksTitle"]
                </h5>

                <p class="display-5 mb-0">
                    @Model.TotalBooks
                </p>

                <small>
                    @Localizer["ActiveBookTitlesDescription"]
                </small>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-xl-3">
        <div class="card text-bg-success h-100">
            <div class="card-body">
                <h5 class="card-title">
                    @Localizer["TotalMembersTitle"]
                </h5>

                <p class="display-5 mb-0">
                    @Model.TotalMembers
                </p>

                <small>
                    @Localizer["ActiveRegisteredPersonsDescription"]
                </small>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-xl-3">
        <div class="card text-bg-info h-100">
            <div class="card-body">
                <h5 class="card-title">
                    @Localizer["ActiveBorrowingsTitle"]
                </h5>

                <p class="display-5 mb-0">
                    @Model.ActiveBorrowings
                </p>

                <small>
                    @Localizer["BooksNotReturnedDescription"]
                </small>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-xl-3">
        <div class="card text-bg-danger h-100">
            <div class="card-body">
                <h5 class="card-title">
                    @Localizer["OverdueBooksTitle"]
                </h5>

                <p class="display-5 mb-0">
                    @Model.OverdueBooks
                </p>

                <small>
                    @Localizer["OverdueBooksDescription"]
                </small>
            </div>
        </div>
    </div>
</div>

@* Borrowing trends and top categories charts *@
<div class="row g-4 mb-4">
    <div class="col-lg-8">
        <div class="card h-100">
            <div class="card-body">
                <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-3">
                    <h5 class="card-title mb-0">
                        @Localizer["BorrowingTrendsTitle"]
                    </h5>

                    @* Reloads the dashboard using the selected
                        borrowing-trend period. *@
                    <form asp-controller="Dashboard"
                          asp-action="Index"
                          method="get"
                          class="d-flex flex-wrap align-items-end gap-2">

                        <div>
                            <label for="trendMonths"
                                   class="form-label mb-1">
                                @Localizer["TrendPeriodLabel"]
                            </label>

                            <select id="trendMonths"
                                    name="trendMonths"
                                    class="form-select">
                                @for (var month = 1; month <= 12; month++)
                                {
                                    if (month == Model.SelectedTrendMonths)
                                    {
                                        <option value="@month" selected>
                                            @month
                                        </option>
                                    }
                                    else
                                    {
                                        <option value="@month">
                                            @month
                                        </option>
                                    }
                                }
                            </select>
                        </div>

                        <button type="submit"
                                class="btn btn-primary">
                            @Localizer["ApplyFilterButton"]
                        </button>
                    </form>
                </div>

                <div style="height: 320px;">
                    <canvas id="borrowingTrendsChart">
                    </canvas>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">
                    @Localizer["TopCategoriesTitle"]
                </h5>

                <div style="height: 320px;">
                    <canvas id="topCategoriesChart">
                    </canvas>
                </div>
            </div>
        </div>
    </div>
</div>

@* Active users chart and most borrowed books table *@
<div class="row g-4 mb-4">
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">
                    @Localizer["ActiveUsersTitle"]
                </h5>

                <div style="height: 300px;">
                    <canvas id="activeUsersChart">
                    </canvas>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">
                    @Localizer["MostBorrowedBooksTitle"]
                </h5>

                @if (Model.MostBorrowedBooks.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-sm align-middle">
                            <thead>
                                <tr>
                                    <th>
                                        @Localizer["BookColumn"]
                                    </th>

                                    <th class="text-end"> @*aligns the words in english to the right and arabic to the left*@
                                        @Localizer["BorrowingsColumn"]
                                    </th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var item
                                    in Model.MostBorrowedBooks)
                                {
                                    <tr>
                                        <td>@item.Name</td>
                                        <td class="text-end">
                                            @item.Count
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-muted">
                        @Localizer["NoBorrowingRecordsMessage"]
                    </p>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @* Chart.js draws the three dashboard charts. *@
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script> @*loading Chart.js*@

    <script>
        const monthlyLabels =
            @Html.Raw(JsonSerializer.Serialize(monthlyLabels)); //converts a C# list into a JavaScript array that Chart.js can understand, the JsonSerializer.Serialize method converts the C# list into a JSON string, and the Html.Raw method ensures that the JSON string is rendered as raw HTML in the view
                                                                // JSON is understood by JavaScript, so it can be used as a JavaScript array
        const monthlyValues =
            @Html.Raw(JsonSerializer.Serialize(monthlyValues)); 

        const categoryLabels =
            @Html.Raw(JsonSerializer.Serialize(categoryLabels));

        const categoryValues =
            @Html.Raw(JsonSerializer.Serialize(categoryValues));

        const activeUserLabels =
            @Html.Raw(JsonSerializer.Serialize(activeUserLabels));

        const activeUserValues =
            @Html.Raw(JsonSerializer.Serialize(activeUserValues));

        // JSON serialization safely handles Arabic text,
        // quotation marks, and other JavaScript-sensitive characters.
        const borrowingsChartLabel =
            @Html.Raw(JsonSerializer.Serialize(
                    borrowingsChartLabel));

        const activeBorrowingsChartLabel =
            @Html.Raw(JsonSerializer.Serialize(
                    activeBorrowingsChartLabel));

        const chartCulture =
            @Html.Raw(JsonSerializer.Serialize(
                    chartCulture));

        const chartIsRightToLeft =
            @Html.Raw(JsonSerializer.Serialize(
                    chartIsRightToLeft));

        const chartTextDirection =
            chartIsRightToLeft ? 'rtl' : 'ltr';

        // Line chart showing borrowing activity during
        // the administrator's selected monthly period.
        new Chart(
            document.getElementById('borrowingTrendsChart'),
            {
                type: 'line',

                data: {
                    labels: monthlyLabels,

                    datasets: [{
                        label: borrowingsChartLabel,
                        data: monthlyValues,
                        borderColor: '#0d6efd',
                        backgroundColor:
                            'rgba(13, 110, 253, 0.15)',
                        fill: true,
                        tension: 0.3
                    }]
                },

                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    locale: chartCulture, // lets Chart.js format values according to English or Arabic

                    plugins: {
                        legend: {
                            rtl: chartIsRightToLeft, // reverses the legend and tooltip layout in Arabic
                            textDirection: chartTextDirection // controls the direction of canvas-rendered text, which does not automatically behave like regular HTML
                        },

                        tooltip: {
                            rtl: chartIsRightToLeft,
                            textDirection: chartTextDirection
                        }
                    },

                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                precision: 0
                            }
                        }
                    }
                }
            });

        // Doughnut chart showing the categories with
        // the highest historical borrowing counts.
        new Chart(
            document.getElementById('topCategoriesChart'),
            {
                type: 'doughnut',

                data: {
                    labels: categoryLabels,

                    datasets: [{
                        label: borrowingsChartLabel,
                        data: categoryValues,

                        backgroundColor: [
                            '#0d6efd',
                            '#198754',
                            '#ffc107',
                            '#dc3545',
                            '#6f42c1'
                        ]
                    }]
                },

                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    locale: chartCulture,

                    plugins: {
                        legend: {
                            rtl: chartIsRightToLeft,
                            textDirection: chartTextDirection
                        },

                        tooltip: {
                            rtl: chartIsRightToLeft,
                            textDirection: chartTextDirection
                        }
                    }
                }
            });

        // Horizontal bar chart showing members with
        // the highest number of active borrowings.
        new Chart(
            document.getElementById('activeUsersChart'),
            {
                type: 'bar',

                data: {
                    labels: activeUserLabels,

                    datasets: [{
                        label: activeBorrowingsChartLabel,
                        data: activeUserValues,
                        backgroundColor: '#20c997'
                    }]
                },

                options: {
                    indexAxis: 'y',
                    responsive: true,
                    maintainAspectRatio: false,
                    locale: chartCulture,

                    plugins: {
                        legend: {
                            rtl: chartIsRightToLeft,
                            textDirection: chartTextDirection
                        },

                        tooltip: {
                            rtl: chartIsRightToLeft,
                            textDirection: chartTextDirection
                        }
                    },

                    scales: {
                        x: {
                            beginAtZero: true,
                            ticks: {
                                precision: 0
                            }
                        }
                    }
                }
            });
    </script>
}