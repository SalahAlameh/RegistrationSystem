@model List<RegistrationSystem.Models.Category>

@* Retrieves Category-page translations from the shared
   English or Arabic resource file. *@
@inject Microsoft.Extensions.Localization.IStringLocalizer<RegistrationSystem.SharedResource> Localizer

@{
    ViewData["Title"] = Localizer["CategoriesTitle"];
}

<h2>@Localizer["CategoriesTitle"]</h2>

<a asp-action="Add" class="btn btn-primary mb-3">@Localizer["AddCategoryButton"]</a>

<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th>@Localizer["CategoryNameLabel"]</th>
            <th>@Localizer["ActionsLabel"]</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var category in Model)
        {
            <tr>
                <td>@category.Name</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@category.Id" class="btn btn-sm btn-warning">@Localizer["EditButton"]</a>

                    <button type="button" class="btn btn-sm btn-danger" data-bs-toggle="modal" data-bs-target="#deleteModal"
                            data-id="@category.Id" data-name="@category.Name">
                        @Localizer["DeleteButton"]
                    </button>
                </td>
            </tr>
        }
    </tbody>
</table>

@await Html.PartialAsync("_DeleteModal")
