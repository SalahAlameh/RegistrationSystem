@model List<RegistrationSystem.Models.Person>

@* Retrieves Person-page translations from the shared
   English or Arabic resource file. *@
@inject Microsoft.Extensions.Localization.IStringLocalizer<RegistrationSystem.SharedResource> Localizer

@{
    ViewData["Title"] = Localizer["RegisteredPersonsTitle"];
}

@*this moves the register action from the navigation bar into the Registered Persons page*@
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>@Localizer["RegisteredPersonsTitle"]</h2>

    <a asp-action="Register"
       class="btn btn-primary">
        @Localizer["RegisterPersonButton"]
    </a>
</div> @*this was previously <h2>Registered Persons</h2>*@

<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th>@Localizer["PersonIdLabel"]</th>
            <th>@Localizer["PersonFullNameLabel"]</th>
            <th>@Localizer["PersonAgeLabel"]</th>
            <th>@Localizer["PersonGenderLabel"]</th>
            <th>@Localizer["PersonMajorLabel"]</th>
            <th>@Localizer["ActionsLabel"]</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var person in Model)
        {
            <tr>
                <td>@person.Id</td>
                <td>@person.FullName</td>
                <td>@person.Age</td>
                <td>
                    @(person.Gender switch
                    {
                        "Male" => Localizer["MaleLabel"].Value,
                        "Female" => Localizer["FemaleLabel"].Value,
                        _ => person.Gender
                    })
                </td>
                <td>@person.Major</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@person.Id" class="btn btn-sm btn-warning">@Localizer["EditButton"]</a>

                    <button type="button" class="btn btn-sm btn-danger" data-bs-toggle="modal" data-bs-target="#deleteModal"
                            data-id="@person.Id" data-name="@person.FullName">
                        @Localizer["DeleteButton"]
                    </button>
                </td>
            </tr>
        }
    </tbody>
</table>

@await Html.PartialAsync("_DeleteModal")
