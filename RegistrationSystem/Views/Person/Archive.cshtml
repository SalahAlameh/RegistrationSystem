@model List<RegistrationSystem.Models.Person>

@{
    ViewData["Title"] = "Archived Persons";
}

<h2>Archived Persons</h2>

<a asp-action="Index" class="btn btn-secondary mb-3">
    Back to Active Persons
</a>

<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th>Full Name</th>
            <th>Age</th>
            <th>Gender</th>
            <th>Major</th>
            <th>Archived At</th>
            <th>Action</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var person in Model)
        {
            <tr>
                <td>@person.FullName</td>
                <td>@person.Age</td>
                <td>@person.Gender</td>
                <td>@person.Major</td>
                <td>@person.DeletedAt?.ToString("g")</td>
                <td>
                    <form asp-action="Restore"
                          asp-route-id="@person.Id"
                          method="post">
                        <button type="submit"
                                class="btn btn-sm btn-success">
                            Restore
                        </button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>