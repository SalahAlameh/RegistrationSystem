@model RegistrationSystem.Models.Person

@* Retrieves Person-page translations from the shared
   English or Arabic resource file. *@
@inject Microsoft.Extensions.Localization.IStringLocalizer<RegistrationSystem.SharedResource> Localizer

@{
    ViewData["Title"] = Localizer["EditPersonTitle"];
}

<h2>@Localizer["EditPersonTitle"]</h2>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" /> @*this is the difference between the Edit and the Register, here it carries 
                                            the persons Id along invisibly when the form submits so that it knows
                                            which row to update rather than creating a new one*@
    

    <div class="mb-3">
        <label asp-for="FullName" class="form-label">@Localizer["PersonFullNameLabel"]</label>
        <input asp-for="FullName" class="form-control" />
        <span asp-validation-for="FullName" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Age" class="form-label">@Localizer["PersonAgeLabel"]</label>
        <input asp-for="Age" class="form-control" />
        <span asp-validation-for="Age" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Gender"
               class="form-label">
            @Localizer["PersonGenderLabel"]
        </label>

        <select asp-for="Gender"
                class="form-select">
            @* The submitted values remain Male and Female,
               while only their displayed text is translated. *@
            <option value="">
                @Localizer["SelectGenderOption"]
            </option>

            <option value="Male">
                @Localizer["MaleLabel"]
            </option>

            <option value="Female">
                @Localizer["FemaleLabel"]
            </option>
        </select>

        <span asp-validation-for="Gender"
              class="text-danger">
        </span>
    </div>

    <div class="mb-3">
        <label asp-for="Major" class="form-label">@Localizer["PersonMajorLabel"]</label>
        <input asp-for="Major" class="form-control" />
        <span asp-validation-for="Major" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">@Localizer["SaveButton"]</button>
    <a asp-action="Index" class="btn btn-secondary">@Localizer["CancelButton"]</a>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
