@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager

@* retrieves the logged-in account ID from the authentication information *@
@inject UserManager<IdentityUser> UserManager

@* uses that ID to find the linked Person *@
@inject RegistrationSystem.Services.PersonService PersonService

@* Retrieves account-navigation translations from
   the shared English or Arabic resource file. *@
@inject Microsoft.Extensions.Localization.IStringLocalizer<RegistrationSystem.SharedResource> Localizer

@{
    var displayName = User.Identity?.Name;

    if (SignInManager.IsSignedIn(User))
    {
        var identityUserId =
            UserManager.GetUserId(User);

        var linkedPerson =
            PersonService.GetByIdentityUserId(
                identityUserId);

        if (linkedPerson != null)
        {
            displayName = linkedPerson.FullName;
        }
    }
}

<ul class="navbar-nav">
    @if (SignInManager.IsSignedIn(User)) // this line checks whether the visitor is logged in
    {
        <li class="nav-item">
            <span class="nav-link text-dark">     
                @Localizer[
                    "HelloGreeting",
                    displayName ?? string.Empty]
                @* {0} is a placeholder that ASP.NET Core replaces with the
   logged-in person's name. This allows each language to position
   the name correctly according to its grammar. *@
            </span>
        </li>

        @if (User.IsInRole("Admin"))
        {
            <li class="nav-item">
                <a class="nav-link text-dark"
                   asp-controller="Account"
                   asp-action="ChangePassword">
                    @Localizer["ChangePasswordLink"]
                </a>
            </li>
        }

        <li class="nav-item">
            <form class="form-inline"
                  asp-controller="Account"
                  asp-action="Logout"
                  method="post">
                <button type="submit"
                        class="nav-link btn btn-link text-dark border-0">
                    @Localizer["LogoutButton"]
                </button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link text-dark"
               asp-controller="Account"
               asp-action="Register">
                @Localizer["SignUpLink"]
            </a>
        </li>

        <li class="nav-item">
            @* Opens the custom MVC Login page instead of
       Microsoft Identity UI's embedded Login page. *@
            <a class="nav-link text-dark"
               asp-controller="Account"
               asp-action="Login">
                @Localizer["LoginLink"]
            </a>
        </li>
    }
</ul>
