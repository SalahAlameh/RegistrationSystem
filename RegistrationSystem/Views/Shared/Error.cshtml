@model ErrorViewModel

@* Retrieves Error-page translations from the
   shared English or Arabic resource file. *@
@inject Microsoft.Extensions.Localization.IStringLocalizer<RegistrationSystem.SharedResource> Localizer

@{
    ViewData["Title"] =
        Localizer["ErrorPageTitle"];
}

<h1 class="text-danger">
    @Localizer["ErrorHeading"]
</h1>

<h2 class="text-danger">
    @Localizer["ErrorProcessingMessage"]
</h2>

@if (Model.ShowRequestId)
{
    <p>
        <strong>
            @Localizer["RequestIdLabel"]
        </strong>

        <code>@Model.RequestId</code>
    </p>
}

<h3>
    @Localizer["DevelopmentModeHeading"]
</h3>

<p>
    @Localizer["DevelopmentModeDescription"]
</p>

<p>
    <strong>
        @Localizer["DevelopmentModeWarning"]
    </strong>
</p>

<p>
    @Localizer[
        "DevelopmentModeInstructions",
        "ASPNETCORE_ENVIRONMENT",
        "Development"]
</p>