@using System.Globalization

@* Retrieves shared layout translations from the
   English or Arabic resource file. *@
@inject Microsoft.Extensions.Localization.IStringLocalizer<RegistrationSystem.SharedResource> Localizer

@{
    // Identifies which language is active so the
    // matching language button can be highlighted.
    var currentCulture = // for example "en"
        CultureInfo.CurrentUICulture
            .TwoLetterISOLanguageName;

    // Arabic is written from right to left.
    // This also supports other RTL languages if added later.
    var isRightToLeft =
        CultureInfo.CurrentUICulture
            .TextInfo
            .IsRightToLeft;


    // Keeps the user on the same page after changing
    // the language, including any query-string values.
    var currentReturnUrl = // for example "/Account/Login?returnUrl=%2FBook"
        $"{Context.Request.PathBase}" +
        $"{Context.Request.Path}" +
        $"{Context.Request.QueryString}";
}

<!DOCTYPE html>
<html lang="@currentCulture"
      dir="@(isRightToLeft ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RegistrationSystem</title>
    <script type="importmap"></script>
    @* Bootstrap provides separate stylesheets for
   left-to-right and right-to-left layouts. *@
    @if (isRightToLeft)
    {
        <link rel="stylesheet"
              href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" />
    }
    else
    {
        <link rel="stylesheet"
              href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    }
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/RegistrationSystem.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand"
                   asp-controller="Book"
                   asp-action="Index">
                    RegistrationSystem
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent"
                        aria-expanded="false"
                        aria-label="@Localizer["ToggleNavigationLabel"]">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    @*this where we add our 2 new li*@

                    <ul class="navbar-nav flex-grow-1">
                        @* The Books link is useful only after authentication. *@
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark"
                                   asp-controller="Book"
                                   asp-action="Index">
                                    @Localizer["NavigationViewBooks"]
                                </a>
                            </li>
                        }

                        @* Only administrators can see the Dashboard and Reports link. *@
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark"
                                   asp-controller="Dashboard"
                                   asp-action="Index">
                                    @Localizer["NavigationDashboard"]
                                </a>
                            </li>
                        }

                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark"
                                   asp-controller="Person"
                                   asp-action="Index">
                                    @Localizer["NavigationRegisteredPersons"]
                                </a>
                            </li>
                        }

                        @* Borrowing history is available only after authentication. *@
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark"
                                   asp-controller="Borrow"
                                   asp-action="ViewBorrowedBooks">
                                    @Localizer["NavigationBorrowedBooks"]
                                </a>
                            </li>
                        }

                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark"
                                   asp-controller="Archive"
                                   asp-action="Index">
                                    @Localizer["NavigationArchive"]
                                </a>
                            </li>
                        }

                        @* Only administrators can see the Users management link. *@
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark"
                                   asp-controller="Users"
                                   asp-action="Index">
                                    @Localizer["NavigationUsers"]
                                </a>
                            </li>
                        }
                    </ul>

                    <div class="d-flex align-items-center">
                        @* Sends the selected language to CultureController.
       The ASP.NET form tag helper automatically adds
       the anti-forgery token required by the action. *@
                        <form asp-controller="Culture"
                              asp-action="SetLanguage"
                              method="post"
                              class="d-flex align-items-center gap-1 me-3">

                            <input type="hidden"
                                   name="returnUrl"
                                   value="@currentReturnUrl" />

                            <button type="submit"
                                    name="culture"
                                    value="en"
                                    class="btn btn-sm @(currentCulture == "en"
                                                    ? "btn-primary"
                                                    : "btn-outline-secondary")"
                                    aria-pressed="@(currentCulture == "en"
                                                ? "true"
                                                : "false")"
                                    aria-label="@Localizer["SwitchToEnglishLabel"]">
                                EN
                            </button>

                            <button type="submit"
                                    name="culture"
                                    value="ar"
                                    class="btn btn-sm @(currentCulture == "ar"
                                                    ? "btn-primary"
                                                    : "btn-outline-secondary")"
                                    aria-pressed="@(currentCulture == "ar"
                                                ? "true"
                                                : "false")"
                                    aria-label="@Localizer["SwitchToArabicLabel"]">
                                AR
                            </button>
                        </form>

                        @await Html.PartialAsync("_LoginPartial")
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - RegistrationSystem - <a asp-area=""
                                              asp-controller="Home"
                                              asp-action="Privacy">
            @Localizer["PrivacyLink"]
        </a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
