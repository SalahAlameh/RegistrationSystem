@model RegistrationSystem.Models.Author

@* Retrieves Author-page translations from the shared
   English or Arabic resource file. *@
@inject Microsoft.Extensions.Localization.IStringLocalizer<RegistrationSystem.SharedResource> Localizer

@{
    ViewData["Title"] = Localizer["AddAuthorTitle"];
}

<h2>@Localizer["AddAuthorTitle"]</h2>

<div asp-validation-summary="ModelOnly"
     class="text-danger">
</div>

<form asp-action="Add" method="post">
    <div class="mb-3">
        <label asp-for="FullName"
               class="form-label">
            @Localizer["AuthorFullNameLabel"]
        </label>

        <input asp-for="FullName"
               class="form-control" />

        <span asp-validation-for="FullName"
              class="text-danger">
        </span>
    </div>

    <button type="submit"
            class="btn btn-primary">
        @Localizer["AddAuthorButton"]
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        @Localizer["CancelButton"]
    </a>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
