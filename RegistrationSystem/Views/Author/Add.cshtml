@model RegistrationSystem.Models.Author

@{
    ViewData["Title"] = "Add Author";
}

<h2>Add Author</h2>

<div asp-validation-summary="ModelOnly"
     class="text-danger">
</div>

<form asp-action="Add" method="post">
    <div class="mb-3">
        <label asp-for="FullName"
               class="form-label">
        </label>

        <input asp-for="FullName"
               class="form-control" />

        <span asp-validation-for="FullName"
              class="text-danger">
        </span>
    </div>

    <button type="submit"
            class="btn btn-primary">
        Add Author
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Cancel
    </a>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}