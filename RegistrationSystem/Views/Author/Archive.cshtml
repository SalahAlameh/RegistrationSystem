@model List<RegistrationSystem.Models.Author>

@* Retrieves Author-page translations from the shared
   English or Arabic resource file. *@
@inject Microsoft.Extensions.Localization.IStringLocalizer<RegistrationSystem.SharedResource> Localizer

@{
    ViewData["Title"] = Localizer["ArchivedAuthorsTitle"];
}

<h2>@Localizer["ArchivedAuthorsTitle"]</h2>

<a asp-action="Index" class="btn btn-secondary mb-3">
    @Localizer["BackToActiveAuthorsButton"]
</a>

<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th>@Localizer["AuthorFullNameLabel"]</th>
            <th>@Localizer["ArchivedAtLabel"]</th>
            <th>@Localizer["ActionsLabel"]</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var author in Model)
        {
            <tr>
                <td>@author.FullName</td>
                <td>@author.DeletedAt?.ToString("g")</td>
                <td>
                    <form asp-action="Restore"
                          asp-route-id="@author.Id"
                          method="post">
                        <button type="submit"
                                class="btn btn-sm btn-success">
                            @Localizer["RestoreButton"]
                        </button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
