@model List<RegistrationSystem.Models.Author>

@{
    ViewData["Title"] = "Archived Authors";
}

<h2>Archived Authors</h2>

<a asp-action="Index" class="btn btn-secondary mb-3">
    Back to Active Authors
</a>

<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th>Full Name</th>
            <th>Archived At</th>
            <th>Action</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var author in Model)
        {
            <tr>
                <td>@author.FullName</td>
                <td>@author.DeletedAt?.ToString("g")</td>
                <td>
                    <form asp-action="Restore"
                          asp-route-id="@author.Id"
                          method="post">
                        <button type="submit"
                                class="btn btn-sm btn-success">
                            Restore
                        </button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>