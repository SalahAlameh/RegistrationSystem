@model List<RegistrationSystem.Models.Author>

@* Retrieves Author-page translations from the shared
   English or Arabic resource file. *@
@inject Microsoft.Extensions.Localization.IStringLocalizer<RegistrationSystem.SharedResource> Localizer

@{
    ViewData["Title"] = Localizer["AuthorsTitle"];
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>@Localizer["AuthorsTitle"]</h2>

    <a asp-action="Add" class="btn btn-primary">
        @Localizer["AddAuthorButton"]
    </a>
</div>

<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th>@Localizer["AuthorFullNameLabel"]</th>
            <th>@Localizer["ActionsLabel"]</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var author in Model)
        {
            <tr>
                <td>@author.FullName</td>

                <td>
                    <a asp-action="Edit" asp-route-id="@author.Id" class="btn btn-sm btn-warning">@Localizer["EditButton"]</a>

                    <button type="button" class="btn btn-sm btn-danger"
                            data-bs-toggle="modal"
                            data-bs-target="#deleteModal"
                            data-id="@author.Id"
                            data-name="@author.FullName">
                        @Localizer["DeleteButton"]
                    </button>
                </td>
            </tr>
        }
    </tbody>
</table>

@await Html.PartialAsync("_DeleteModal")
