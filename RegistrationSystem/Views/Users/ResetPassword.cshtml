@model RegistrationSystem.Models.ResetUserPasswordViewModel

@* Retrieves Users-page translations from the shared
   English or Arabic resource file. *@
@inject Microsoft.Extensions.Localization.IStringLocalizer<RegistrationSystem.SharedResource> Localizer

@{
    ViewData["Title"] = Localizer["ResetUserPasswordTitle"];
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-header">
                <h2 class="h4 mb-0">@Localizer["ResetUserPasswordTitle"]</h2>
            </div>

            <div class="card-body">
                <p class="text-muted">
                    @Localizer["ResetUserPasswordDescription"]
                </p>

                <form asp-action="ResetPassword" method="post">
                    <div asp-validation-summary="ModelOnly"
                         class="text-danger">
                    </div>

                    <input asp-for="Id" type="hidden" />

                    <div class="mb-3">
                        <label asp-for="Email"
                               class="form-label">
                            @Localizer["EmailLabel"]
                        </label>

                        <input asp-for="Email"
                               class="form-control"
                               readonly />
                    </div>

                    <div class="mb-3">
                        <label asp-for="NewPassword"
                               class="form-label">
                            @Localizer["NewPasswordLabel"]
                        </label>

                        <input asp-for="NewPassword"
                               class="form-control" />

                        <span asp-validation-for="NewPassword"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ConfirmNewPassword"
                               class="form-label">
                            @Localizer["ConfirmNewPasswordLabel"]
                        </label>

                        <input asp-for="ConfirmNewPassword"
                               class="form-control" />

                        <span asp-validation-for="ConfirmNewPassword"
                              class="text-danger">
                        </span>
                    </div>

                    <button type="submit"
                            class="btn btn-primary">
                        @Localizer["ResetPasswordButton"]
                    </button>

                    <a asp-action="Index"
                       class="btn btn-secondary">
                        @Localizer["CancelButton"]
                    </a>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial");
    }
}
