@model List<RegistrationSystem.Models.UserListViewModel>

@using System.Text.Json

@* Retrieves Users-page translations from the shared
   English or Arabic resource file. *@
@inject Microsoft.Extensions.Localization.IStringLocalizer<RegistrationSystem.SharedResource> Localizer

@{
    ViewData["Title"] = Localizer["UsersManagementTitle"];

    string GetRoleLabel(string role) => role switch
    {
        "Admin" => Localizer["AdminRoleLabel"].Value,
        "User" => Localizer["UserRoleValueLabel"].Value,
        _ => role
    };
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2>@Localizer["UsersManagementTitle"]</h2>
        <p class="text-muted mb-0">
            @Localizer["UsersManagementDescription"]
        </p>
    </div>

    <a asp-action="Create" class="btn btn-primary">
        @Localizer["CreateUserButton"]
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show"
         role="alert">
        @TempData["SuccessMessage"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="@Localizer["CloseButtonLabel"]">
        </button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show"
         role="alert">
        @TempData["ErrorMessage"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="@Localizer["CloseButtonLabel"]">
        </button>
    </div>
}

<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-striped table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>@Localizer["EmailLabel"]</th>
                        <th>@Localizer["UserRoleLabel"]</th>
                        <th>@Localizer["LinkedPersonLabel"]</th>
                        <th>@Localizer["UserStatusLabel"]</th>
                        <th class="text-end">@Localizer["ActionsLabel"]</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model.Any())
                    {
                        @foreach (var user in Model)
                        {
                            <tr>
                                <td class="align-middle">
                                    @(string.IsNullOrWhiteSpace(user.Email)
                                        ? Localizer["NoEmailLabel"]
                                        : user.Email)

                                    @if (user.IsCurrentUser)
                                    {
                                        <span class="badge bg-info text-dark ms-1">
                                            @Localizer["CurrentUserBadge"]
                                        </span>
                                    }
                                </td>

                                <td class="align-middle">
                                    <span class="badge bg-secondary">
                                        @(string.IsNullOrWhiteSpace(user.Role)
                                            ? Localizer["NoRoleLabel"]
                                            : string.Join(
                                                ", ",
                                                user.Role
                                                    .Split(
                                                        ',',
                                                        StringSplitOptions.RemoveEmptyEntries)
                                                    .Select(role =>
                                                        GetRoleLabel(role.Trim()))))
                                    </span>
                                </td>

                                <td class="align-middle">
                                    @if (string.IsNullOrWhiteSpace(user.LinkedPersonName))
                                    {
                                        <span class="text-muted">
                                            @Localizer["NotLinkedLabel"]
                                        </span>
                                    }
                                    else
                                    {
                                        @user.LinkedPersonName
                                    }
                                </td>

                                <td class="align-middle">
                                    @if (user.IsDisabled)
                                    {
                                        <span class="badge bg-danger">
                                            @Localizer["DeactivatedStatus"]
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">
                                            @Localizer["ActiveStatus"]
                                        </span>
                                    }
                                </td>

                                <td class="text-end align-middle">
                                    <a asp-action="Edit"
                                       asp-route-id="@user.Id"
                                       class="btn btn-sm btn-warning">
                                        @Localizer["EditButton"]
                                    </a>

                                    @if (!user.IsCurrentUser)
                                    {
                                        <a asp-action="ResetPassword"
                                           asp-route-id="@user.Id"
                                           class="btn btn-sm btn-outline-primary">
                                            @Localizer["ResetPasswordButton"]
                                        </a>
                                    }
                                    else
                                    {
                                        <a asp-controller="Account"
                                           asp-action="ChangePassword"
                                           class="btn btn-sm btn-outline-primary">
                                            @Localizer["ChangePasswordLink"]
                                        </a>
                                    }

                                    @if (user.IsDisabled)
                                    {
                                        <form asp-action="Enable"
                                              asp-route-id="@user.Id"
                                              method="post"
                                              class="d-inline">
                                            <button type="submit"
                                                    class="btn btn-sm btn-success">
                                                @Localizer["ReactivateButton"]
                                            </button>
                                        </form>
                                    }
                                    else if (!user.IsCurrentUser)
                                    {
                                        <button type="button"
                                                class="btn btn-sm btn-danger"
                                                data-bs-toggle="modal"
                                                data-bs-target="#disableUserModal"
                                                data-id="@user.Id"
                                                data-email="@user.Email">
                                            @Localizer["DeactivateButton"]
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button"
                                                class="btn btn-sm btn-outline-secondary"
                                                disabled
                                                title="@Localizer["CannotDeactivateOwnAccountTooltip"]">
                                            @Localizer["DeactivateButton"]
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5"
                                class="text-center text-muted py-4">
                                @Localizer["NoUserAccountsMessage"]
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@* This modal deactivates an account instead of permanently deleting it. *@
<div class="modal fade"
     id="disableUserModal"
     tabindex="-1"
     aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">@Localizer["ConfirmDeactivationTitle"]</h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="@Localizer["CloseButtonLabel"]">
                </button>
            </div>

            <div class="modal-body">
                <div id="disableUserConfirmationMessage"></div>

                <p class="text-muted mt-2 mb-0">
                    @Localizer["DeactivationExplanation"]
                </p>
            </div>

            <div class="modal-footer">
                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    @Localizer["CancelButton"]
                </button>

                <form id="disableUserForm"
                      asp-action="Disable"
                      method="post">
                    <input type="hidden"
                           name="id"
                           id="disableUserId" />

                    <button type="submit"
                            class="btn btn-danger">
                        @Localizer["DeactivateButton"]
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var disableUserConfirmationTemplate =
            @Html.Raw(JsonSerializer.Serialize(
                Localizer["DisableUserConfirmationMessage"].Value));

        var disableUserModal =
            document.getElementById('disableUserModal');

        disableUserModal.addEventListener(
            'show.bs.modal',
            function(event) {
                var button = event.relatedTarget;
                var userId = button.getAttribute('data-id');
                var userEmail = button.getAttribute('data-email');

                document.getElementById('disableUserId').value =
                    userId;

                document.getElementById(
                    'disableUserConfirmationMessage'
                ).textContent =
                    disableUserConfirmationTemplate.replace(
                        '{0}',
                        function() {
                            return userEmail;
                        });
            });
    </script>
}
