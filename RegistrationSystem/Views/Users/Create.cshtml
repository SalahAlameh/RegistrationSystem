@model RegistrationSystem.Models.CreateUserViewModel

@{
    ViewData["Title"] = "Create User";
}

<div class="row justify-content-center">
    <div class="col-md-7 col-lg-6">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0">Create User</h4>
            </div>

            <div class="card-body">
                <p class="text-muted">
                    Create a login account and assign its initial role.
                </p>

                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3">
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email"
                               class="form-label">
                        </label>

                        <input asp-for="Email"
                               class="form-control"
                               autocomplete="email" />

                        <span asp-validation-for="Email"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password"
                               class="form-label">
                        </label>

                        <input asp-for="Password"
                               class="form-control"
                               autocomplete="new-password" />

                        <span asp-validation-for="Password"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ConfirmPassword"
                               class="form-label">
                        </label>

                        <input asp-for="ConfirmPassword"
                               class="form-control"
                               autocomplete="new-password" />

                        <span asp-validation-for="ConfirmPassword"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="SelectedRole"
                               class="form-label">
                        </label>

                        <select asp-for="SelectedRole"
                                asp-items="Model.Roles"
                                class="form-select">
                        </select>

                        <span asp-validation-for="SelectedRole"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="PersonId"
                               class="form-label">
                        </label>

                        <select asp-for="PersonId"
                                asp-items="Model.Persons"
                                class="form-select">
                            <option value="">-- No linked person --</option>
                        </select>

                        <span asp-validation-for="PersonId"
                              class="text-danger">
                        </span>

                        <div class="form-text">
                            A User account must be linked to a Person.
                            Admin accounts may remain unlinked.
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit"
                                class="btn btn-primary">
                            Create User
                        </button>

                        <a asp-action="Index"
                           class="btn btn-secondary">
                            Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}