@model RegistrationSystem.Models.CreateUserViewModel

@* Retrieves Users-page translations from the shared
   English or Arabic resource file. *@
@inject Microsoft.Extensions.Localization.IStringLocalizer<RegistrationSystem.SharedResource> Localizer

@{
    ViewData["Title"] = Localizer["CreateUserTitle"];
}

<div class="row justify-content-center">
    <div class="col-md-7 col-lg-6">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0">@Localizer["CreateUserTitle"]</h4>
            </div>

            <div class="card-body">
                <p class="text-muted">
                    @Localizer["CreateUserDescription"]
                </p>

                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3">
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email"
                               class="form-label">
                            @Localizer["EmailLabel"]
                        </label>

                        <input asp-for="Email"
                               class="form-control"
                               autocomplete="email" />

                        <span asp-validation-for="Email"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password"
                               class="form-label">
                            @Localizer["PasswordLabel"]
                        </label>

                        <input asp-for="Password"
                               class="form-control"
                               autocomplete="new-password" />

                        <span asp-validation-for="Password"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ConfirmPassword"
                               class="form-label">
                            @Localizer["ConfirmPasswordLabel"]
                        </label>

                        <input asp-for="ConfirmPassword"
                               class="form-control"
                               autocomplete="new-password" />

                        <span asp-validation-for="ConfirmPassword"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="SelectedRole"
                               class="form-label">
                            @Localizer["UserRoleLabel"]
                        </label>

                        <select asp-for="SelectedRole"
                                class="form-select">
                            @foreach (var role in Model.Roles)
                            {
                                var roleLabel = role.Value switch
                                {
                                    "Admin" => Localizer["AdminRoleLabel"].Value,
                                    "User" => Localizer["UserRoleValueLabel"].Value,
                                    _ => role.Text
                                };

                                if (role.Selected)
                                {
                                    <option value="@role.Value" selected>
                                        @roleLabel
                                    </option>
                                }
                                else
                                {
                                    <option value="@role.Value">
                                        @roleLabel
                                    </option>
                                }
                            }
                        </select>

                        <span asp-validation-for="SelectedRole"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="PersonId"
                               class="form-label">
                            @Localizer["LinkedPersonLabel"]
                        </label>

                        <select asp-for="PersonId"
                                asp-items="Model.Persons"
                                class="form-select">
                            <option value="">@Localizer["NoLinkedPersonOption"]</option>
                        </select>

                        <span asp-validation-for="PersonId"
                              class="text-danger">
                        </span>

                        <div class="form-text">
                            @Localizer["LinkedPersonHelpText"]
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit"
                                class="btn btn-primary">
                            @Localizer["CreateUserButton"]
                        </button>

                        <a asp-action="Index"
                           class="btn btn-secondary">
                            @Localizer["CancelButton"]
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
