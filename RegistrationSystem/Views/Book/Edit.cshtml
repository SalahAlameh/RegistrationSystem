@model RegistrationSystem.Models.BookViewModel

@* Retrieves Book-page translations from the shared
   English or Arabic resource file. *@
@inject Microsoft.Extensions.Localization.IStringLocalizer<
RegistrationSystem.SharedResource > Localizer

@{
    ViewData["Title"] =
        Localizer["EditBookTitle"];
}

<h2>
    @Localizer["EditBookTitle"]
</h2>

<form asp-action="Edit"
      method="post">

    <input type="hidden"
           asp-for="Id" />

    <div class="mb-3">
        <label asp-for="Title"
               class="form-label">
            @Localizer["BookTitleLabel"]
        </label>

        <input asp-for="Title"
               class="form-control" />

        <span asp-validation-for="Title"
              class="text-danger">
        </span>
    </div>

    <div class="mb-3">
        <label asp-for="CategoryId"
               class="form-label">
            @Localizer["CategoryLabel"]
        </label>

        <select asp-for="CategoryId"
                asp-items="Model.Categories"
                class="form-select">
            <option value="">
                @Localizer["SelectCategoryOption"]
            </option>
        </select>

        <span asp-validation-for="CategoryId"
              class="text-danger">
        </span>
    </div>

    <div class="mb-3">
        <label asp-for="SelectedAuthorIds"
               class="form-label">
            @Localizer["AuthorsLabel"]
        </label>

        <select asp-for="SelectedAuthorIds"
                asp-items="Model.Authors"
                class="form-select"
                multiple
                size="5">
        </select>

        <span asp-validation-for="SelectedAuthorIds"
              class="text-danger">
        </span>
    </div>

    <div class="mb-3">
        <label asp-for="Copies"
               class="form-label">
            @Localizer["CopiesLabel"]
        </label>

        <input asp-for="Copies"
               class="form-control" />

        <span asp-validation-for="Copies"
              class="text-danger">
        </span>
    </div>

    <button type="submit"
            class="btn btn-primary">
        @Localizer["SaveButton"]
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        @Localizer["CancelButton"]
    </a>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial");
    }
}