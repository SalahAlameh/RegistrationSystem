@model List<RegistrationSystem.Models.Book>

@* Retrieves Book-page translations from the shared
   English or Arabic resource file. *@
@inject Microsoft.Extensions.Localization.IStringLocalizer<
RegistrationSystem.SharedResource > Localizer

@{
    ViewData["Title"] =
        Localizer["BooksTitle"];
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>
        @Localizer["BooksTitle"]
    </h2>

    <div class="d-flex gap-2">
        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Add"
               class="btn btn-primary">
                @Localizer["AddBookButton"]
            </a>

            <a asp-controller="Author"
               asp-action="Index"
               class="btn btn-secondary">
                @Localizer["AuthorsPageButton"]
            </a>

            <a asp-controller="Category"
               asp-action="Index"
               class="btn btn-secondary">
                @Localizer["CategoriesPageButton"]
            </a>
        }

        <a asp-controller="Borrow"
           asp-action="BorrowBook"
           class="btn btn-success">
            @Localizer["BorrowBookButton"]
        </a>
    </div>
</div> @*this moves the add book action from the navigation bar into the Books page*@

<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th>@Localizer["BookTitleLabel"]</th>
            <th>@Localizer["AuthorsLabel"]</th>
            <th>@Localizer["CategoryLabel"]</th>
            <th>@Localizer["CopiesLabel"]</th>
            <th>@Localizer["ActionsLabel"]</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var book in Model)
        {
            <tr>
                <td>@book.Title</td>

                <td>
                    @if (book.Authors.Any())
                    {
                        @string.Join(
                            ", ",
                            book.Authors.Select(
                                author => author.FullName))
                    }
                    else
                    {
                        <span class="text-muted">
                            @Localizer["NoAuthorsAssigned"]
                        </span>
                    }
                </td>

                <td>
                    @(book.Category?.Name ??
                        Localizer["UncategorizedLabel"])
                </td>

                <td>@book.Copies</td>

                <td>
                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-action="Edit"
                           asp-route-id="@book.Id"
                           class="btn btn-sm btn-warning">
                            @Localizer["EditButton"]
                        </a>

                        <button type="button"
                                class="btn btn-sm btn-danger"
                                data-bs-toggle="modal"
                                data-bs-target="#deleteModal"
                                data-id="@book.Id"
                                data-name="@book.Title">
                            @Localizer["DeleteButton"]
                        </button>
                    }
                    else
                    {
                        <span class="text-muted">
                            @Localizer["ViewOnlyLabel"]
                        </span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

@if (User.IsInRole("Admin"))
{
    @await Html.PartialAsync("_DeleteModal")
    @*This prevents regular Users from seeing controls that they cannot use*@
}