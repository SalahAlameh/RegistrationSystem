@model List<RegistrationSystem.Models.Book>

@{
    ViewData["Title"] = "Books";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Books</h2>

    <div class="d-flex gap-2">
        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Add"
               class="btn btn-primary">
                Add Book
            </a>

            <a asp-controller="Author"
               asp-action="Index"
               class="btn btn-secondary">
                Authors
            </a>

            <a asp-controller="Category"
               asp-action="Index"
               class="btn btn-secondary">
                Categories
            </a>
        }

        <a asp-controller="Borrow"
           asp-action="BorrowBook"
           class="btn btn-success">
            Borrow Book
        </a>
    </div>
</div> @*this moves the add book action from the navigation bar into the Books page*@

<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th>Title</th>
            <th>Authors</th>
            <th>Category</th>
            <th>Copies</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var book in Model)
        {
            <tr>
                <td>@book.Title</td>
                <td>
                    @if (book.Authors.Any())
                    {
                        @string.Join(", ",
                            book.Authors.Select(author => author.FullName))
                    }
                    else
                    {
                        <span class="text-muted">
                            No authors assigned
                        </span>
                    }
                </td>
                <td>@(book.Category?.Name ?? "Uncategorized")</td>
                <td>@book.Copies</td>
                <td>
                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-action="Edit"
                           asp-route-id="@book.Id"
                           class="btn btn-sm btn-warning">
                            Edit
                        </a>

                        <button type="button"
                                class="btn btn-sm btn-danger"
                                data-bs-toggle="modal"
                                data-bs-target="#deleteModal"
                                data-id="@book.Id"
                                data-name="@book.Title">
                            Delete
                        </button>
                    }
                    else
                    {
                        <span class="text-muted">
                            View only
                        </span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

@if (User.IsInRole("Admin"))
{
    @await Html.PartialAsync("_DeleteModal") @*This prevents regular Users from seeing controls that they cannot use*@
}