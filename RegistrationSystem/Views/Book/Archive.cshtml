@model List<RegistrationSystem.Models.Book>

@{
    ViewData["Title"] = "Archived Books";
}

<h2>Archived Books</h2>

<a asp-action="Index" class="btn btn-secondary mb-3">
    Back to Active Books
</a>

<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th>Title</th>
            <th>Category</th>
            <th>Copies</th>
            <th>Archived At</th>
            <th>Action</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var book in Model)
        {
            <tr>
                <td>@book.Title</td>
                <td>@(book.Category?.Name ?? "Uncategorized")</td>
                <td>@book.Copies</td>
                <td>@book.DeletedAt?.ToString("g")</td>
                <td>
                    <form asp-action="Restore"
                          asp-route-id="@book.Id"
                          method="post">
                        <button type="submit"
                                class="btn btn-sm btn-success">
                            Restore
                        </button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>