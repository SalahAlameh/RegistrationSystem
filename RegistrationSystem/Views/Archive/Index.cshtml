@model RegistrationSystem.Models.ArchiveViewModel

@* Retrieves Archive-page translations from the shared
   English or Arabic resource file. *@
@inject Microsoft.Extensions.Localization.IStringLocalizer<RegistrationSystem.SharedResource> Localizer

@{
    ViewData["Title"] = Localizer["ArchivePageTitle"];
}

<h2>@Localizer["ArchivePageTitle"]</h2>

<h4 class="mt-4">@Localizer["ArchivedPersonsTitle"]</h4>

@if (Model.Persons.Any())
{
    <table class="table table-striped table-bordered">
        <thead class="table-dark">
            <tr>
                <th>@Localizer["PersonFullNameLabel"]</th>
                <th>@Localizer["ArchivedAtLabel"]</th>
                <th>@Localizer["ActionsLabel"]</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var person in Model.Persons)
            {
                <tr>
                    <td>@person.FullName</td>
                    <td>@(person.DeletedAt.HasValue
                        ? $"{person.DeletedAt.Value:yyyy-MM-dd HH:mm} UTC"
                        : "")</td>
                    <td>
                        <form asp-controller="Person"
                              asp-action="Restore"
                              asp-route-id="@person.Id"
                              method="post">
                            <button type="submit"
                                    class="btn btn-sm btn-success">
                                @Localizer["RestoreButton"]
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p class="text-muted">@Localizer["NoArchivedPersonsMessage"]</p>
}

