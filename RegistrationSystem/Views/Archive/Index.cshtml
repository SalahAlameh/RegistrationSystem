@model RegistrationSystem.Models.ArchiveViewModel

@{
    ViewData["Title"] = "Archive";
}

<h2>Archive</h2>

<h4 class="mt-4">Archived Persons</h4>

@if (Model.Persons.Any())
{
    <table class="table table-striped table-bordered">
        <thead class="table-dark">
            <tr>
                <th>Full Name</th>
                <th>Archived At</th>
                <th>Action</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var person in Model.Persons)
            {
                <tr>
                    <td>@person.FullName</td>
                    <td>@(person.DeletedAt.HasValue
                        ? $"{person.DeletedAt.Value:yyyy-MM-dd HH:mm} UTC"
                        : "")</td>
                    <td>
                        <form asp-controller="Person"
                              asp-action="Restore"
                              asp-route-id="@person.Id"
                              method="post">
                            <button type="submit"
                                    class="btn btn-sm btn-success">
                                Restore
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p class="text-muted">No archived persons.</p>
}

